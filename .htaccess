# ============================================================
# CONFIGURACIÓN GENERAL
# ============================================================

RewriteEngine On
Options -Indexes
DirectoryIndex index.php

# ============================================================
# REDIRIGIR INDEX.PHP HACIA LA RAÍZ
# ============================================================

RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ / [R=301,L]

# ============================================================
# DESARROLLO LOCAL
# ============================================================

# En localhost se utiliza HTTP para evitar problemas con
# certificados locales. Se usa 302 para no guardar la
# redirección permanentemente en el navegador.

RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTPS} on
RewriteRule ^ http://%{HTTP_HOST}%{REQUEST_URI} [R=302,L,NE]

# ============================================================
# DOMINIO CANÓNICO Y HTTPS EN PRODUCCIÓN
# ============================================================

# Corrige en una sola redirección:
# - HTTP a HTTPS
# - www a dominio sin www
# - cualquier host diferente al dominio oficial

RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^libreriamarquense\.com$ [NC]
RewriteRule ^ https://libreriamarquense.com%{REQUEST_URI} [R=301,L,NE]

# ============================================================
# BLOQUEAR DIRECTORIOS PRIVADOS
# ============================================================

RewriteRule ^(?:config|logs|storage|docs|assets/php)(?:/|$) - [F,L,NC]

# No se bloquea /api/ porque contiene endpoints utilizados
# por el carrito, pedidos y la pasarela de pago.

# No se bloquea /integrations/ hasta confirmar que no contiene
# webhooks o rutas que deban recibir solicitudes externas.

# ============================================================
# PREVENIR ACCESO A ARCHIVOS SENSIBLES
# ============================================================

<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|bak|backup|old|env|pem|key|p12|pfx|crt|csr)$">
    Require all denied
</FilesMatch>

<FilesMatch "(private|secret|credential|credentials).*\.(php|json|txt|xml|yml|yaml)$">
    Require all denied
</FilesMatch>

# ============================================================
# ENCABEZADOS DE SEGURIDAD
# ============================================================

<IfModule mod_headers.c>

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"

    <If "%{HTTPS} == 'on'">
        Header always set Strict-Transport-Security "max-age=31536000"
    </If>

</IfModule>

# No agregar includeSubDomains o preload a HSTS hasta confirmar
# que todos los subdominios utilizan HTTPS permanentemente.

# ============================================================
# COMPRESIÓN
# ============================================================

<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE \
        text/html \
        text/plain \
        text/xml \
        text/css \
        application/javascript \
        application/json \
        application/xml \
        image/svg+xml

</IfModule>

# ============================================================
# CACHÉ DE ARCHIVOS ESTÁTICOS
# ============================================================

<IfModule mod_expires.c>

    ExpiresActive On

    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"

    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"

    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

</IfModule>

# ============================================================
# PROTECCIÓN Y CODIFICACIÓN
# ============================================================

ServerSignature Off
AddDefaultCharset UTF-8