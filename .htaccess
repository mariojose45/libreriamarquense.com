# ============================================================
# LIBRERÍA MARQUENSE
# CONFIGURACIÓN GENERAL
# ============================================================

RewriteEngine On

Options -Indexes
DirectoryIndex index.php


# ============================================================
# DESARROLLO LOCAL
# ============================================================

# En localhost utilizar HTTP.
# 302 evita guardar permanentemente la redirección.
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTPS} on
RewriteRule ^ http://%{HTTP_HOST}%{REQUEST_URI} [R=302,L,NE]


# ============================================================
# DOMINIO CANÓNICO Y HTTPS EN PRODUCCIÓN
# ============================================================

# Fuerza:
# - HTTP -> HTTPS
# - www -> sin www
# - dominio oficial: libreriamarquense.com

RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^libreriamarquense\.com$ [NC]
RewriteRule ^ https://libreriamarquense.com%{REQUEST_URI} [R=301,L,NE]


# ============================================================
# REDIRIGIR INDEX.PHP HACIA LA RAÍZ
# ============================================================

# Evita que /index.php sea una URL duplicada.
# QSD elimina cualquier parámetro antiguo.
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[\s?]) [NC]
RewriteRule ^index\.php$ / [R=301,L,NE,QSD]


# ============================================================
# LIMPIAR PARÁMETROS ANTIGUOS DE ADD-TO-CART
# ============================================================

# El sitio anterior generaba URLs con ?add-to-cart=...
# En las páginas actuales este parámetro ya no representa
# contenido independiente.
#
# Se aplica únicamente a páginas actuales conocidas.
# QSD elimina completamente la query string antigua.

RewriteCond %{HTTP_HOST} ^libreriamarquense\.com$ [NC]
RewriteCond %{QUERY_STRING} (^|&)add-to-cart=[0-9]+(&|$) [NC]
RewriteCond %{REQUEST_URI} ^/(?:|tienda\.php|servicios\.php|ofertas\.php|menosde100\.php|nosotros\.php|contact\.php|preguntas_frecuentes\.php|metodos_de_pago\.php|politicas_de_garantia\.php|terminos\.php|derechos\.php)$ [NC]
RewriteRule ^(.*)$ /$1 [R=301,L,NE,QSD]


# ============================================================
# BLOQUEAR DIRECTORIOS PRIVADOS
# ============================================================

RewriteRule ^(?:config|logs|storage|docs)(?:/|$) - [F,L,NC]


# ============================================================
# PROTEGER ASSETS/PHP
# ============================================================

# productos_paginados.php debe permanecer accesible porque
# la tienda lo utiliza mediante peticiones HTTP.
#
# Los demás archivos de assets/php quedan bloqueados
# para acceso directo desde el navegador.

RewriteRule ^assets/php/(?!productos_paginados\.php$) - [F,L,NC]


# ============================================================
# PREVENIR ACCESO A ARCHIVOS SENSIBLES
# ============================================================

<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|bak|backup|old|env|pem|key|p12|pfx|crt|csr)$">
    Require all denied
</FilesMatch>

<FilesMatch "(private|secret|credential|credentials).*\.(php|json|txt|xml|yml|yaml)$">
    Require all denied
</FilesMatch>


# ============================================================
# PROTEGER ARCHIVOS OCULTOS
# ============================================================

<FilesMatch "^\.">
    Require all denied
</FilesMatch>


# ============================================================
# ENCABEZADOS DE SEGURIDAD
# ============================================================

<IfModule mod_headers.c>

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"

    # HSTS solamente sobre HTTPS.
    <If "%{HTTPS} == 'on'">
        Header always set Strict-Transport-Security "max-age=31536000"
    </If>

</IfModule>

# No agregar includeSubDomains ni preload hasta confirmar
# que todos los subdominios utilizarán HTTPS permanentemente.


# ============================================================
# COMPRESIÓN
# ============================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>


# ============================================================
# CACHÉ DE ARCHIVOS ESTÁTICOS
# ============================================================

<IfModule mod_expires.c>

    ExpiresActive On

    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"

    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"

    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

</IfModule>


# ============================================================
# CONFIGURACIÓN FINAL
# ============================================================

ServerSignature Off
AddDefaultCharset UTF-8