# ===============================
# CONFIGURACIÓN PARA DESARROLLO LOCAL
# Este archivo NO fuerza HTTPS en localhost
# ===============================
RewriteEngine On

# Redirigir HTTPS a HTTP SOLO en localhost (para desarrollo)
RewriteCond %{HTTPS} on
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:.*)?$ [NC]
RewriteRule ^(.*)$ http://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ===============================
# PREVENIR ACCESO A ARCHIVOS SENSIBLES
# ===============================
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|bak)$">
    Require all denied
</FilesMatch>

# ===============================
# COMPRESIÓN GZIP (opcional, mejora rendimiento)
# ===============================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# ===============================
# CACHE PARA MEJOR RENDIMIENTO (opcional)
# ===============================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg  "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif  "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>
