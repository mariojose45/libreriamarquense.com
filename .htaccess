# ===============================
# CONFIGURACIÓN GENERAL
# ===============================

RewriteEngine On
Options -Indexes

# ===============================
# FORZAR HTTPS (EXCEPTO LOCALHOST)
# TEMPORALMENTE DESACTIVADO
# 
# Este bloque se debe activar SOLO cuando el SSL/HTTPS
# ya funcione correctamente en:
#
# https://libreriamarquense.com/index.php
# https://libreriamarquense.com/cart.php
# https://libreriamarquense.com/api/cybersource/test.php
#
# Si se activa ahorita, manda el sitio a HTTPS
# y como HTTPS está fallando, aparece 404.
# ===============================

# RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:.*)?$ [NC]
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]


# ===============================
# REDIRIGIR HTTPS A HTTP SOLO EN LOCALHOST
# ===============================

RewriteCond %{HTTPS} on
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:.*)?$ [NC]
RewriteRule ^(.*)$ http://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]


# ===============================
# PREVENIR ACCESO A ARCHIVOS SENSIBLES
# ===============================

<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|bak|backup|old|env|pem|key|p12|pfx|crt|csr)$">
    Require all denied
</FilesMatch>

<FilesMatch "(private|secret|credential|credentials).*\.(php|json|txt|xml|yml|yaml)$">
    Require all denied
</FilesMatch>


# ===============================
# COMPRESIÓN GZIP
# ===============================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>


# ===============================
# CACHE PARA MEJOR RENDIMIENTO
# ===============================

<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/jpg  "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif  "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"

    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>


# ===============================
# UTF-8
# ===============================

AddDefaultCharset UTF-8